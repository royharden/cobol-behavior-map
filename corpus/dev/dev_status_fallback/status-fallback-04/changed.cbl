IDENTIFICATION DIVISION.
PROGRAM-ID. STATUS-FALLBACK-04.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
SELECT INFILE ASSIGN TO "input.dat" ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS IN-STATUS.
SELECT OUTFILE ASSIGN TO "output.dat" ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS OUT-STATUS.
DATA DIVISION.
FILE SECTION.
FD INFILE.
01 IN-REC.
05 PAYLOAD PIC X(6) VALUE "UNSET".
FD OUTFILE.
01 OUT-REC.
05 OUT-TEXT PIC X(3).
05 OUT-MARK PIC X(1) VALUE "R".
WORKING-STORAGE SECTION.
01 IN-STATUS PIC X(2) VALUE "00".
01 OUT-STATUS PIC X(2) VALUE "00".
01 IN-OPENED PIC X(1) VALUE "N".
01 OUT-OPENED PIC X(1) VALUE "N".
PROCEDURE DIVISION.
MAIN.
OPEN INPUT INFILE
IF IN-STATUS = "00"
    MOVE "Y" TO IN-OPENED
END-IF
OPEN OUTPUT OUTFILE
IF OUT-STATUS = "00"
    MOVE "Y" TO OUT-OPENED
END-IF
IF IN-OPENED = "Y"
    READ INFILE AT END
        MOVE "READY" TO PAYLOAD
        MOVE "E" TO OUT-MARK
    END-READ
ELSE
    MOVE "MISS" TO PAYLOAD
    MOVE "M" TO OUT-MARK
END-IF
MOVE PAYLOAD TO OUT-TEXT
IF OUT-OPENED = "Y"
    WRITE OUT-REC
END-IF
DISPLAY IN-STATUS "/" OUT-STATUS
IF IN-OPENED = "Y"
    CLOSE INFILE
    DISPLAY IN-STATUS
END-IF
IF OUT-OPENED = "Y"
    CLOSE OUTFILE
    DISPLAY OUT-STATUS
END-IF
STOP RUN.
