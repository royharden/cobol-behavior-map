IDENTIFICATION DIVISION.
PROGRAM-ID. STATUS-TWO-READ-01.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
SELECT INFILE ASSIGN TO "input.dat" ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS IN-STATUS.
SELECT OUTFILE ASSIGN TO "output.dat" ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS OUT-STATUS.
DATA DIVISION.
FILE SECTION.
FD INFILE.
01 IN-REC.
05 PAYLOAD PIC X(5) VALUE "UNSET".
FD OUTFILE.
01 OUT-REC.
05 OUT-TEXT PIC X(2).
05 OUT-ORDER PIC 9(1).
05 OUT-MARK PIC X(1) VALUE "R".
WORKING-STORAGE SECTION.
01 IN-STATUS PIC X(2) VALUE "00".
01 OUT-STATUS PIC X(2) VALUE "00".
01 IN-OPENED PIC X(1) VALUE "N".
01 OUT-OPENED PIC X(1) VALUE "N".
01 READ-COUNT PIC 9(1) VALUE 0.
01 VARIANT-TAG PIC X(1) VALUE "A".
PROCEDURE DIVISION.
MAIN.
OPEN INPUT INFILE
IF IN-STATUS = "00"
    MOVE "Y" TO IN-OPENED
END-IF
OPEN OUTPUT OUTFILE
IF OUT-STATUS = "00"
    MOVE "Y" TO OUT-OPENED
END-IF
IF IN-OPENED = "Y"
    READ INFILE AT END
        MOVE "F" TO OUT-MARK
    END-READ
    IF IN-STATUS = "00"
        ADD 1 TO READ-COUNT END-ADD
        PERFORM EMIT-ROW
    END-IF
    IF IN-STATUS = "00"
        READ INFILE AT END
            MOVE "E" TO OUT-MARK
        END-READ
        IF IN-STATUS = "00"
            ADD 1 TO READ-COUNT END-ADD
            IF READ-COUNT >= 2
                PERFORM EMIT-ROW
            END-IF
        END-IF
    END-IF
END-IF
DISPLAY IN-STATUS "/" OUT-STATUS
IF IN-OPENED = "Y"
    CLOSE INFILE
    DISPLAY IN-STATUS
END-IF
IF OUT-OPENED = "Y"
    CLOSE OUTFILE
    DISPLAY OUT-STATUS
END-IF
STOP RUN.
EMIT-ROW.
IF OUT-OPENED = "Y"
    MOVE PAYLOAD TO OUT-TEXT
    MOVE READ-COUNT TO OUT-ORDER
    MOVE VARIANT-TAG TO OUT-MARK
    WRITE OUT-REC
END-IF
.
